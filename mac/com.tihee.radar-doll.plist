<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Agenda do doll no Mac: roda mac/rodar_doll.sh de 30 em 30 min.
     __PASTA__ e __LOG__ sao trocados pelo mac/ligar_agendamento.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tihee.radar-doll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PASTA__/mac/rodar_doll.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
