# Supabase — chave service_role fica SÓ aqui e nos secrets do GitHub, nunca no código
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Alerta (opcional) — mesmo padrão dos outros agentes
DISCORD_WEBHOOK=

# Classificacao por LLM (opcional) — sem a chave, o radar usa o modo por palavra-chave
ANTHROPIC_API_KEY=

# Imagem destacada — exigencia pratica do Google Discover (>= 1200px).
# Chave gratuita em pexels.com/api, 2 minutos. SEM ela nao sai imagem nenhuma
# e os posts perdem o card do Discover. Ver radar/imagens.py.
PEXELS_API_KEY=

# Alternativa sem cadastro, DESLIGADA por padrao. O Openverse passa no tamanho
# mas erra na relevancia (acervo documental, nao de stock): medindo pelos
# termos dos hubs, "travel passport" trouxe documento da Alemanha nazista e
# "home cooked main dish", foto da Agencia Espacial Europeia. So' ligue se
# alguem for revisar imagem por imagem.
IMAGENS_OPENVERSE=

# WordPress — senha de APLICATIVO, nunca a senha da conta
# (WP Admin -> Usuarios -> Perfil -> Senhas de aplicativo). O usuario precisa
# ter permissao de criar posts E de subir midia (Autor ja' basta).
WP_DOLL_USUARIO=
WP_DOLL_SENHA=

# Blogs Tihee — a esteira radar.publicar usa estas. Site sem credencial aqui
# simplesmente nao publica (a falha fica registrada na tabela execucoes).
WP_BROUNE_USUARIO=
WP_BROUNE_SENHA=
WP_DIVADABELEZA_USUARIO=
WP_DIVADABELEZA_SENHA=
WP_CINEARTCAFE_USUARIO=
WP_CINEARTCAFE_SENHA=
WP_PESCARIA_USUARIO=
WP_PESCARIA_SENHA=
WP_GUIADOMOTORISTA_USUARIO=
WP_GUIADOMOTORISTA_SENHA=
